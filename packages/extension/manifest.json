{
  "manifest_version": 3,
  "name": "Flow MCP Bridge",
  "version": "0.1.0",
  "description": "Local bridge that lets AI agents drive Google Flow (flow.google.com) through your own signed-in session.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "scripting",
    "alarms",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://flow-content.google/*",
    "https://*.googleusercontent.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow MCP Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "isolated.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
